paths:
  duckdb_path: data/market.duckdb
  output_dir: data/output
  logs_dir: data/logs
  stock_name_cache: data/stock_names.csv
  # asof_trade_date: ""

logging:
  format: text

akshare:
  adjust: qfq
  sleep_between_symbols_sec: 0.5
  max_fetch_retries: 3
  retry_delay_sec: 2.0
  request_timeout_sec: 10.0
  fetch_workers: 2
  daily_source_preference: sina
  daily_allow_fallback: true

database:
  table_daily: a_share_daily
  table_audit: data_fetch_audit
  auto_backfill_derived_on_init: true
  apply_legacy_migrations: false

quality:
  max_calendar_gap_days: 20
  null_ratio_max: 0.05
  fail_on_ohlc_invalid: true
  fail_on_large_gaps: true

trend_signal:
  mode: macd_cross
  consensus_n_agree: 2
  macd_fast: 12
  macd_slow: 26
  macd_signal: 9
  ma_fast: 5
  ma_slow: 20
  ma_smooth: 3
  boll_window: 20
  min_run_len: 1

signal_filter:
  volume_confirm: false
  volume_lookback: 20
  volume_ratio_min: 1.0
  min_quality_score: 0
  quality_score_mode: hard
  quality_score_floor: 0.3
  meta_label_mode: off
  meta_label_threshold: 0.50
  require_above_ma120: false
  require_positive_rs60: false
  require_weekly_bullish: false
  weekly_ma_fast: 5
  weekly_ma_slow: 13

backtest:
  cost_bps: 15.0
  initial_capital: 100000
  execution: tplus1_open
  stop_loss_pct: 0.0
  trailing_stop_pct: 0.0
  atr_stop_multiplier: 0.0
  atr_stop_period: 14
  risk_per_trade_pct: 0.0
  position_size_cap: 1.0
  stop_reentry_enabled: false
  stop_reentry_cooldown: 3
  stop_reentry_min_run: 2
  time_stop_days: 0
  time_stop_min_return: 0.0
  profit_lock_trigger: 0.0
  profit_lock_trailing: 0.0
  market_exit_mode: off
  volatility_target_ann: 0.0
  volatility_lookback: 20
  volatility_high_vol_multiple: 1.5
  volatility_high_vol_scale: 0.5
  drawdown_throttle_enabled: false
  transaction_cost:
    commission_buy_bps: 2.5
    commission_sell_bps: 2.5
    slippage_bps_per_side: 2.0
    stamp_duty_sell_bps: 5.0

wfo:
  param_grid:
    # Keep combos under ~1000; expand per experiment.
    macd_fast: [8, 12]
    macd_slow: [22, 30]
    macd_signal: [7, 9]
    min_run_len: [1, 2, 3]
    stop_loss_pct: [0.0, 0.06, 0.10]
    atr_stop_multiplier: [0.0, 2.0]
    min_quality_score: [0, 30]
    time_stop_days: [0, 30]
    profit_lock_trigger: [0.0, 0.15]
    profit_lock_trailing: [0.0, 0.08]
    volatility_target_ann: [0.0]
    drawdown_throttle_enabled: [false]

risk:
  enable_index_filter: false
  benchmark_symbol: "510300"
  extreme_lookback_days: 10
  extreme_drop_threshold: 0.05
  risk_off_factor: 0.0
  # R10 — regime gate for new entry permission (requires CSI300 index data)
  regime_gate_enabled: false
  regime_ma_fast: 20
  regime_ma_slow: 60

notify:
  wecom_webhook_url: ""
  mention_all: false
